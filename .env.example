NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Server-only. Never prefix with NEXT_PUBLIC_ or import into client components.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Used for canonical sitemap URLs. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Public business details shown on Contact and policy pages. Leave blank until verified.
NEXT_PUBLIC_BUSINESS_ADDRESS=
RESEND_API_KEY=
EMAIL_FROM=
ORDER_NOTIFICATION_EMAIL=
# Optional reply-to address for both customer and store-owner emails.
EMAIL_REPLY_TO=
# Optional: set only when your trusted reverse proxy uses a different client-IP header.
# Never point this at a header that clients can pass through unchanged.
# RATE_LIMIT_IP_HEADER=x-forwarded-for
